{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "es2022": true
  },
  "ignorePatterns": ["dist"],
  "rules": {
    "typescript/no-explicit-any": "off",
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  }
}
