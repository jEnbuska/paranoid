{
  "name": "paranoid",
  "author": "Joona Enbuska",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "test": "pnpm -r run test && node --test \"scripts/**/*.test.mts\"",
    "check:deploy-docs": "node scripts/check-deploy-docs.mts",
    "test:e2e": "pnpm --filter e2e test:e2e",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint",
    "knip": "knip --reporter symbols --reporter ./scripts/knip-explain.mts",
    "build": "pnpm -r run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "knip": "^6.45.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
