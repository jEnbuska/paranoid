# Committed to the public repository: non-secret defaults only. Never put a
# secret or token here. Put local secrets and overrides in .env.local next to
# this file, which git ignores.

# Signaling server settings, read with Node's --env-file-if-exists, and then
# .env.local, whose values win. Variables already set in the environment take
# precedence over both.

# Port the server listens on.
# PORT=8181

# Address the server listens on, for example 127.0.0.1 behind a reverse proxy
# on the same machine. Unset means every interface.
# HOST=127.0.0.1

# Comma-separated browser origins allowed to connect (CORS).
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# How many invites the server creates before it exits: a whole number of at
# least 1. Once the last of them is finished, the server exits with code 0.
# Unset means no limit, and the server never exits on its own.
# MAX_INVITES=1
