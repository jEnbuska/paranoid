VITE_SIGNALING_SERVER=localhost:8181
VITE_APP_NAME=Paranoid
# STUN servers, as a JSON array of RTCIceServer objects with only `urls`. Unset
# means Google's public STUN servers, which see users' IP addresses. A
# self-hosted server avoids that. An invalid value stops `vite build` and
# `vite dev`.
# This is built into the client and visible to anyone using the app, so static
# TURN credentials must not be put here, and the check refuses them.
# VITE_ICE_SERVERS='[{"urls":"stun:stun.example.com:3478"}]'
