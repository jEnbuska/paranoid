{
  "$schema": "../requirements.schema.json",
  "guide": "docs/deploy/hetzner.md",
  "environments": {
    "hetzner": {
      "reviewers": "required",
      "step": "#create-the-environments",
      "secrets": {
        "HCLOUD_TOKEN": {
          "required": true,
          "pattern": "^[A-Za-z0-9]{64}$",
          "step": "#create-the-tokens-and-add-them"
        }
      }
    },
    "hetzner-cleanup": {
      "reviewers": "none",
      "step": "#create-the-environments",
      "secrets": {
        "HCLOUD_TOKEN": {
          "required": true,
          "pattern": "^[A-Za-z0-9]{64}$",
          "step": "#create-the-tokens-and-add-them"
        }
      }
    }
  },
  "variables": {
    "HCLOUD_LOCATION": {
      "pattern": "^(nbg1|fsn1|hel1)$",
      "example": "nbg1",
      "environments": ["hetzner"],
      "step": "#5-optional-settings"
    },
    "HCLOUD_SERVER_TYPES": {
      "pattern": "^[a-z0-9]{1,20}(,[a-z0-9]{1,20}){0,9}$",
      "example": "cx23,cax11,cpx12",
      "environments": ["hetzner"],
      "step": "#5-optional-settings"
    }
  }
}
