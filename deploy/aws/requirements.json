{
  "$schema": "../requirements.schema.json",
  "guide": "docs/deploy/aws.md",
  "environments": {
    "aws": {
      "reviewers": "required",
      "step": "#the-environments",
      "variables": {
        "AWS_ROLE_ARN": {
          "required": true,
          "pattern": "^arn:aws:iam::[0-9]{12}:role/paranoid-deploy$",
          "example": "arn:aws:iam::123456789012:role/paranoid-deploy",
          "step": "#the-ids-in-them"
        },
        "AWS_SCHEDULER_ROLE_ARN": {
          "required": true,
          "pattern": "^arn:aws:iam::[0-9]{12}:role/paranoid-scheduler$",
          "example": "arn:aws:iam::123456789012:role/paranoid-scheduler",
          "step": "#the-ids-in-them"
        },
        "AWS_SECURITY_GROUP_ID": {
          "required": true,
          "pattern": "^sg-[0-9a-f]{8,17}$",
          "example": "sg-0123456789abcdef0",
          "step": "#the-ids-in-them"
        }
      }
    },
    "aws-cleanup": {
      "reviewers": "none",
      "step": "#the-environments",
      "variables": {
        "AWS_ROLE_ARN": {
          "required": true,
          "pattern": "^arn:aws:iam::[0-9]{12}:role/paranoid-cleanup$",
          "example": "arn:aws:iam::123456789012:role/paranoid-cleanup",
          "step": "#the-ids-in-them"
        }
      }
    }
  },
  "variables": {
    "AWS_REGION": {
      "pattern": "^(eu-north-1|eu-central-1|eu-west-1)$",
      "example": "eu-north-1",
      "step": "#6-optional-settings"
    },
    "AWS_INSTANCE_TYPE": {
      "pattern": "^(t4g\\.micro|t4g\\.small|t3\\.micro|t3\\.small)$",
      "example": "t4g.micro",
      "environments": ["aws"],
      "step": "#6-optional-settings"
    }
  }
}
