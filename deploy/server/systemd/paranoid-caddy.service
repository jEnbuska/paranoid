[Unit]
Description=Caddy, serving Paranoid over HTTPS
After=network-online.target paranoid-signaling.service
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/caddy run --config /opt/paranoid/app/deploy/server/Caddyfile --adapter caddyfile
# PARANOID_HOST, the hostname to get a certificate for
EnvironmentFile=/etc/paranoid/caddy.env
# Certificates go in the state directory, /var/lib/paranoid-caddy/caddy.
Environment=XDG_DATA_HOME=/var/lib/paranoid-caddy XDG_CONFIG_HOME=/var/lib/paranoid-caddy
StateDirectory=paranoid-caddy
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576

# Its own throwaway user that may only bind ports 80 and 443, and a read-only
# view of the system apart from its state directory.
DynamicUser=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# A call outside the list fails with EPERM instead of killing the process.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
