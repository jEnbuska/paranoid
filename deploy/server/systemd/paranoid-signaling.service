[Unit]
Description=Paranoid signaling server
After=network-online.target paranoid-egress.service
Wants=network-online.target
# The server exits with code 0 only once its last invite is finished
# (MAX_INVITES), and then the whole machine powers off. Any other exit, a
# signal included, counts as a failure, so stopping the service doesn't.
SuccessAction=poweroff
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=/opt/paranoid/app/packages/signaling-server
ExecStart=/opt/paranoid/node/bin/node src/server.ts
EnvironmentFile=/etc/paranoid/signaling.env
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=2s

# Its own throwaway user, no privileges, and a read-only view of the system.
DynamicUser=yes
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
SystemCallArchitectures=native
# A call outside the list fails with EPERM instead of killing the process.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# V8's JIT needs memory that is writable and executable, so no
# MemoryDenyWriteExecute.

# It talks only to Caddy, on this machine: it listens on 127.0.0.1, and
# nothing else can reach it or be reached from it.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
